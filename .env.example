# Copy this template OUTSIDE the repository; chmod 600 the private file.
# No shell expansion, command substitution, or variable interpolation is performed.
STACK_NAME=lightrag-local
LIGHTRAG_NAMESPACE=lightrag-local
# Existing environment network; it must reach PostgreSQL.
NETWORK_NAME=knowledge-net
# Existing PostgreSQL database with pgvector enabled.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DATABASE=lightrag
POSTGRES_PASSWORD=
CONTROLLER_PORT=19632
DOCLING_PORT=15002
DOCLING_ALIAS=docling
# true only for a Linux host Backend able to route to Docker bridge IPs.
# Container Backend on NETWORK_NAME should use false (Docker DNS).
ADVERTISE_CONTAINER_IP=true
LIGHTRAG_CONTROLLER_TOKEN=
LIGHTRAG_API_KEY=
LLM_BINDING=openai
LLM_BINDING_HOST=
LLM_BINDING_API_KEY=
LLM_MODEL=
EXTRACT_LLM_MODEL=
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
